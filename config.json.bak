      "core://my_user",
      "core://agent/my_user"
    ]
  },
  "host": "127.0.0.1",
  "web_port": 8233,
  "auto_open_browser": true,
  "api_token": null,
  "cors_origins": null,
  "public_readonly_mcp": false,
  "locale": null
}
