{
  "database_url": "sqlite+aiosqlite:////root/nocturne_memory/nocturne_data.db",
  "db_pool_size": 5,
  "db_max_overflow": 5,
  "valid_domains": [
    "core",
    "writer",
    "game",
    "notes",
    "narrative"
